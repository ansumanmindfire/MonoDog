{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": "../../",
    "allowJs": true,
    "paths": {
      "@mindfiredigital/utils": ["libs/utils/index.ts"],
      "@mindfiredigital/monorepo-scanner": [
        "packages/monorepo-scanner/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../libs/utils/**/*",
    "../../packages/monorepo-scanner/src/**/*"
  ]
}
